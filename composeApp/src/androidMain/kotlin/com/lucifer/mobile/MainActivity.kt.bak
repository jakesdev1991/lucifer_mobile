@OptIn(ExperimentalMaterial3Api::class)
class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            LuciferTheme {
                val scope = remember { CoroutineScope(Dispatchers.Main) }

                // Initialize services
                val metaRouter = remember { MetaCognitiveRouter() }
                val kaiBridge = remember { KaiBridge(this@MainActivity) }
                val contextCompressor = remember { ContextCompressor() }
                val evidenceLedger = remember { EvidenceLedger() }
                val fourHorsemen = remember { FourHorsemenOrchestrator() }
                val clusterManager = remember { ClusterManager() }

                val heartbeatService = remember {
                    HeartbeatService.create(
                        metaRouter = metaRouter,
                        kaiBridge = kaiBridge,
                        contextCompressor = contextCompressor,
                        evidenceLedger = evidenceLedger,
                        fourHorsemen = fourHorsemen,
                        clusterManager = clusterManager,
                        scope = scope
                    )
                }

                // Start heartbeat on app launch
                scope.launch {
                    heartbeatService.start()
                }

                // Connect to Kai sandbox on start
                var kaiConnected by remember { mutableStateOf(false) }
                var connectionError by remember { mutableStateOf<String?>(null) }

                scope.launch {
                    try {
                        KaiBridge(this@MainActivity).connect().await()
                        kaiConnected = true
                    } catch (e: Exception) {
                        connectionError = e.message
                    }
                }

                var selectedTab by remember { mutableStateOf(0) }

                Box(
                    modifier = Modifier.fillMaxSize(),
                    contentAlignment = Alignment.Center
                ) {
                    Surface(
                        modifier = Modifier.fillMaxSize(),
                        color = LuciferColors.Obsidian
                    ) {
                        Column(
                            modifier = Modifier.fillMaxSize(),
                            verticalArrangement = Arrangement.spacedBy(0.dp)
                        ) {
                            // Animated Tab Row
                            AnimatedTabBar(
                                selectedTab = selectedTab,
                                onTabSelected = { selectedTab = it },
                                tabs = listOf(
                                    TabItem("Terminal", Terminal),
                                    TabItem("Memory", Memory),
                                    TabItem("Skills", Psychology),
                                    TabItem("Settings", Settings)
                                )
                            )

                            // Tab Content
                            when (selectedTab) {
                                0 -> AnimatedTerminal(
                                    modifier = Modifier.fillMaxSize(),
                                    outputLines = listOf("🫀 Heartbeat service started", "🔗 Kai Bridge: Connecting...", "💰 Wallet: Ready"),
                                    isProcessing = false,
                                    onCommand = { }
                                )
                                1 -> AnimatedMemoryPanel(
                                    modifier = Modifier.fillMaxSize(),
                                    memories = listOf(),
                                    onSearch = { },
                                    isSearching = false
                                )
                                2 -> AnimatedSkillsPanel(
                                    modifier = Modifier.fillMaxSize(),
                                    skills = listOf(),
                                    onToggle = { _, _ -> }
                                )
                                3 -> AnimatedSettingsPanel(
                                    modifier = Modifier.fillMaxSize(),
                                    soulMdText = "",
                                    heartbeatPromptText = "",
                                    onSoulMdEdit = { },
                                    onHeartbeatEdit = { },
                                    onWalletConnect = { },
                                    onDeployKaiBridge = { }
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}

