<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Every line below is claimed by code that runs. The rule this file now follows: if a permission has
        no call site, it is not declared — a declared-but-dead permission is a promise the APK cannot keep,
        and it widens the surface the OS (and anyone reading the manifest) must assume.

        Withdrawn in this revision, with the reason:
          BLUETOOTH / BLUETOOTH_ADMIN / BLUETOOTH_CONNECT / BLUETOOTH_SCAN
              no Bluetooth API call anywhere in the tree. Radio toggling is user-controlled in Settings,
              which the Settings tab already opens. Nothing to connect was ever built.
          NFC
              no NfcAdapter, no reader mode, no tag dispatch. Nothing read, nothing written.
          USE_FINGERPRINT
              deprecated alias, superseded by USE_BIOMETRIC, which is now actually used (security/BiometricGate.kt).
          READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE
              never had a call site, and are not needed for the export path: ExportBundle writes through the
              system file picker (SAF), which grants one URI without granting a storage permission. Scoped
              storage also makes WRITE_EXTERNAL_STORAGE a no-op on API 30+.

        ACCESS_LOCAL_NETWORK stays because the Terminal serves a local website on 127.0.0.1:8080 for the
        user's own browser (terminal/LocalWebsiteManager.kt); Android 16 gates that with this permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice input: SpeechRecognizer streams audio to the system speech service. Requested at runtime,
         only when the MIC control is pressed; the recogniser is destroyed when it answers. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Wired: security/BiometricGate.kt puts a fingerprint/face/PIN check in front of owner calls and
         world changes. On a device with no sensor and no lock the gate says so and the confirmation
         dialog stands alone. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Package visibility (Android 11+): a launcher must see every other app -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.mirfatif.permissionmanagerx" />
        <package android:name="com.termux" />
        <package android:name="com.android.virtualization.terminal" />
        <package android:name="com.rosan.dhizuku" />
        <package android:name="net.typeblog.shelter" />
        <package android:name="com.oasisfeng.island" />
        <package android:name="com.oasisfeng.island.fdroid" />
    </queries>

    <application
        android:name=".LuciferApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lucifer"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lucifer"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ─── Lucifer Launcher: the home screen IS the agent ─── -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="true"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Lucifer"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".launcher.PackageEventReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <service
            android:name=".terminal.TermuxResultService"
            android:exported="false" />

        <service
            android:name=".terminal.FloatingChatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-visible floating chat companion while Lucifer's terminal session is active" />
        </service>

        <!-- Starts only after explicit opt-in; after reboot resumes text-only until camera is re-authorized in-app. -->
        <service
            android:name=".omni_bridge.heartbeat.LuciferHeartbeatService"
            android:exported="false"
            android:foregroundServiceType="dataSync|camera" />

        <!-- The General: user-enabled, notification-visible, proposes only. No execution path. -->
        <service
            android:name=".agents.android.TacticianService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Lucifer's Lean verification server: binds 127.0.0.1 only. Publishing it needs a tunnel the
          owner starts by hand; the service opens no route to the internet itself.
        -->
        <service
            android:name=".verification.VerificationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Device-admin component: the identity Lucifer needs to create and manage its own world.
          Inactive until the owner provisions it (dpm set-device-owner) or a tool such as Dhizuku
          transfers ownership. Declaring it grants nothing by itself.
        -->
        <receiver
            android:name=".privilege.LuciferDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".omni_bridge.heartbeat.HeartbeatBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku API provider. The user still starts the Shizuku server and grants Lucifer access in Shizuku. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>